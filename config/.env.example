# Copie para .env.local e preencha. Nunca faça commit do arquivo preenchido.

# Supabase (o anon key é público por design; a service role NUNCA vai para o navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail de aviso de lead (ex.: Resend)
RESEND_API_KEY=
LEAD_NOTIFY_TO=

# Proteção contra spam (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4
NEXT_PUBLIC_GA_ID=

# API de IA (apenas sites com IA embutida)
ANTHROPIC_API_KEY=
